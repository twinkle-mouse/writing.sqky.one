---
const size = 96;
---

<div class="transcube-container">
    <p>Trans Cube</p>

    <label class="sr-only">A 3 dimensional cube with the transgender flag on every side, infinitely rotating in a symmetrical manner.</label>

    <div aria-hidden="true" class="transcube-box">
        <div class="transcube">
            <div class="anim" style="animation: 4s linear infinite rotate; transform: rotate3d(1, 0, 0, 45deg)">
                <div class="anim" style="animation: 6s linear infinite rotate; transform: rotate3d(0, 1, 0, 90deg)">
                    <div class="anim" style="animation: 8s linear infinite rotate; transform: rotate3d(0, 0, 1, 135deg)">
                        <div class="face" style=`transform: rotateZ(90deg) translateZ(calc(var(--s) / 2));` />
                        <div class="face" style=`transform: rotateZ(90deg) rotateY(180deg) translateZ(calc(var(--s) / 2));` />
                        <div class="face" style=`transform: rotateY(-90deg) translateZ(calc(var(--s) / 2));` />
                        <div class="face" style=`transform: rotateY(90deg) translateZ(calc(var(--s) / 2));` />
                        <div class="face" style=`transform: rotateX(90deg) translateZ(calc(var(--s) / 2));` />
                        <div class="face" style=`transform: rotateX(-90deg) translateZ(calc(var(--s) / 2));` />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @media (prefers-reduced-motion) {
        .transcube-container {
            display: none !important;
        }
    }

    .transcube-box {
        display: flex;
        justify-content: center;
        align-items: center;

        height: auto;

        margin-inline: auto;

        flex: 1 1;
    }

    .transcube {
        display: flex;
        justify-content: center;
        align-items: center;

        min-width: calc(var(--s) * 2);
        min-height: calc(var(--s) * 2);

        margin-inline: 0.5rem;
        margin-block: 1.5em;

        user-select: none;

        transition: filter 0.5s ease;
    }

    .transcube:has(.face:hover) {
        filter: drop-shadow(0px 0px calc(var(--s) / 12) rgba(255, 255, 255, 0.25)) drop-shadow(0px 0px calc(var(--s) / 8) rgba(255, 255, 255, 0.5))
            drop-shadow(0px 0px calc(var(--s) / 6) rgba(255, 255, 255, 0.75));
    }

    .anim {
        width: var(--s);
        height: var(--s);

        transform-style: preserve-3d;
        backface-visibility: hidden;
        animation-composition: add;
    }

    .face {
        display: block;
        position: absolute;

        width: var(--s);
        height: var(--s);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        background-image: linear-gradient(
            0deg,
            #5ccefa,
            #5ccefa 20%,
            #f6a8b7 20%,
            #f6a8b7 40%,
            #fff 40%,
            #fff 60%,
            #f6a8b7 60%,
            #f6a8b7 80%,
            #5ccefa 80%,
            #5ccefa
        );
        box-shadow:
            0 0 2px #000,
            0 0 3px #000;
    }
</style>

<style define:vars={{ size: `${size}px` }}>
    .transcube {
        --s: var(--size);
    }

    @media (max-width: 1300px) {
        .transcube {
            --s: calc(var(--size) / 1.5);
        }
    }
</style>
